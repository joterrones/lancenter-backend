# Postgres Valetor en RDS (nombre de BD en minúsculas: valetor)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/valetor?sslmode=require
PORT=3701
HOST=0.0.0.0

# Fly:
# fly secrets set -a lancenter-backend DATABASE_URL="postgresql://...@.../valetor?sslmode=require" JWT_SECRET="..." ADMIN_PASSWORD="..."

JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@lancenter.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Operador
